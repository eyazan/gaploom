class_name Music
extends Node
## Looping per-world ambient music with a short crossfade. Tracks are generated by
## tools/make_music.py (project-owned). Silent until enabled and a track is requested.

const PATH := "res://assets/music/%s.wav"
const VOLUME_DB := -13.0
const FADE := 1.2

static var instance: Music
var enabled := true
var current := ""
var _players: Array[AudioStreamPlayer] = []
var _active := 0
var _cache: Dictionary = {}


func _ready() -> void:
	instance = self
	for i in 2:
		var p := AudioStreamPlayer.new()
		p.volume_db = -80.0
		add_child(p)
		_players.append(p)


func _stream(world: String) -> AudioStream:
	if _cache.has(world):
		return _cache[world]
	var path := PATH % world
	if not ResourceLoader.exists(path):
		return null
	var s: AudioStream = load(path)
	if s is AudioStreamWAV:
		var w := s as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(round(w.get_length() * w.mix_rate))
	_cache[world] = s
	return s


func play(world: String) -> void:
	if world == current and _players[_active].playing:
		return
	current = world
	if not enabled:
		return
	var s := _stream(world)
	if s == null:
		return
	var old := _players[_active]
	_active = 1 - _active
	var nxt := _players[_active]
	nxt.stream = s
	nxt.volume_db = -40.0
	nxt.play()
	var t := create_tween().set_parallel(true)
	t.tween_property(nxt, "volume_db", VOLUME_DB, FADE)
	if old.playing:
		t.tween_property(old, "volume_db", -60.0, FADE)
		t.chain().tween_callback(old.stop)


func set_enabled(on: bool) -> void:
	enabled = on
	if not on:
		for p in _players:
			p.stop()
	else:
		var w := current
		current = ""
		if w != "":
			play(w)


func is_playing() -> bool:
	return _players[_active].playing
